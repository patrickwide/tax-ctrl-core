# tax_ctrl_core is runtime-swappable: the database backend is chosen from
# the DATABASE_URL scheme at connection time, not hardcoded at compile time.
# Copy this file to `.env` and pick ONE of the options below.

# --- Local-first / development (recommended default) -----------------------
# SQLite is the recommended default when testing locally or building the
# initial local-first engine. No external service required.
DATABASE_URL=sqlite://tax_ctrl.db?mode=rwc

# --- Shared office / production ---------------------------------------------
# PostgreSQL is the recommended default for a shared production environment.
# Uncomment and configure instead of the SQLite line above:
# DATABASE_URL=postgres://user:password@localhost:5432/tax_ctrl

# Optional: used by CI to run the PostgreSQL connection test against a
# throwaway database. Leave unset for local development.
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/tax_ctrl_test
